{
  "name": "orangehrm-playwright-qa",
  "version": "1.0.0",
  "private": true,
  "description": "OrangeHRM demo UI QA using Playwright JavaScript, Allure and Newman",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:api": "newman run postman/orangehrm-api.collection.json -e postman/orangehrm-api.environment.json",
    "test:allure:generate": "allure generate allure-results --clean -o allure-report",
    "test:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.0",
    "newman": "^6.2.1"
  }
}
